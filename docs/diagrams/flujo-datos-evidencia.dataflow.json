    { "id": "f-reaudit-verify", "from": "reaudit_check", "to": "missions_verify", "label": "Reauditoría OK", "classification": "paridad", "variant": "default", "route": "straight", "labelDy": -24 },
    { "id": "f-verify-result", "from": "missions_verify", "to": "result_json", "label": "Sella hash", "classification": "ACCEPTED", "variant": "emphasis", "route": "straight", "labelDy": -26 }
  ]
