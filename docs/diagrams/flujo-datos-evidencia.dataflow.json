    { "id": "missions_verify", "type": "security", "label": "missions.py verify", "sublabel": "Puerta de aceptación", "tag": "valida scope", "stage": 3, "row": 1, "width": 128 },
    { "id": "reaudit_check", "type": "backend", "label": "missions.py reaudit", "sublabel": "Valida diff vs tarea", "tag": "coherencia", "stage": 3, "row": 2, "width": 128 },
    { "id": "result_json", "type": "database", "label": "result.json", "sublabel": "Veredicto sellado", "tag": "hashes inmutables", "stage": 4, "row": 1, "width": 128 }
