{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-flow:modes:1",
  "title": "Mode contract",
  "description": "Contract for a generated mode (e.g., <Project>-auditor). Located in generated/modes/<name>/. Exactly two final modes per project.",
  "x-owner": "creator",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "preset_id",
    "role",
    "purpose",
    "reuse_source",
    "triggers",
    "anti_triggers",
    "inputs",
    "reads",
    "writes",
    "required_capabilities",
    "forbidden_capabilities",
    "invariants",
    "anti_goals",
    "mode_lifecycle",
    "state_machine",
    "handoffs",
    "failure_modes",
    "scenarios",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "mode",
      "description": "Explicit discriminator for mode contracts."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Mode name, project-prefixed (e.g., MyProject-auditor)."
    },
    "preset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Selectable DSH user-preset identifier; required for newly generated modes."
    },
    "role": {
      "type": "string",
      "enum": [
        "auditor",
        "continuous-repair"
      ],
      "description": "Final operational role exposed by the preset."
    },
    "mode_lifecycle": {
      "type": "object",
      "description": "Exact role-specific lifecycle; validated by the shared Host validator.",
      "required": [
        "schema_version",
        "role",
        "state_root",
        "state_schema",
        "read_before_write",
        "write_method",
        "bounds",
        "startup",
        "tool_policy"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "auditor"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "tool_policy": {
                "required": [
                  "bash_workdir"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "continuous-repair"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "repair_candidate"
            ],
            "properties": {
              "repair_candidate": {
                "required": [
                  "candidate_location",
                  "directory_template",
                  "branch_template",
                  "candidate_root",
                  "forbidden_candidate_location",
                  "candidate_workdir",
                  "provision_workdir",
                  "provision_command",
                  "recording_command",
                  "record_before_first_edit",
                  "record_statuses",
                  "candidate_diff_command",
                  "reconcile_command",
                  "resume_command",
                  "resume_policy",
                  "resume_statuses",
                  "stale_record_policy",
                  "stale_record_precondition",
                  "resume_required_checks",
                  "unrecorded_dirty_target",
                  "interrupted_turn_recovery",
                  "provision_checks",
                  "unrelated_candidates",
                  "worktree_list_scope",
                  "provision",
                  "collision_policy"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "role": {
          "enum": [
            "auditor",
            "continuous-repair"
          ]
        },
        "state_root": {
          "type": "string",
          "pattern": ".+/mode-state$"
        },
        "state_schema": {
          "const": "state-schema.json"
        },
        "read_before_write": {
          "const": true
        },
        "write_method": {
          "const": "workflow_write-full-replacement-not-atomic"
        },
        "bounds": {
          "type": "object"
        },
        "startup": {
          "type": "object",
          "required": [
            "startup_workdir",
            "workdir_override",
            "first_post_skill_tool",
            "first_bash_workdir",
            "first_bash_command",
            "success_sentinel",
            "expected_cwd_basename",
            "relative_layout_checks",
            "path_resolution",
            "pwd_drift"
          ],
          "additionalProperties": false,
          "properties": {
            "startup_workdir": {
              "const": "session-cwd-only"
            },
            "workdir_override": {
              "const": "forbidden-before-layout"
            },
            "first_post_skill_tool": {
              "const": "bash"
            },
            "first_bash_workdir": {
              "const": "omitted-or-dot"
            },
            "first_bash_command": {
              "type": "string",
              "minLength": 1
            },
            "success_sentinel": {
              "const": "__IMPROVEMENT_LAYOUT_OK__"
            },
            "expected_cwd_basename": {
              "type": "string",
              "minLength": 1
            },
            "relative_layout_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\./[^/]+$"
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "path_resolution": {
              "const": "observed-unchanged-session-cwd"
            },
            "pwd_drift": {
              "const": "RETAINED"
            }
          }
        },
        "tool_policy": {
          "type": "object",
          "required": [
            "escalation_channel",
            "forbidden_arguments",
            "forbidden_argument_values",
            "denial_policy"
          ],
          "properties": {
            "bash_workdir": {
              "const": "session-cwd-only-all-calls",
              "description": "Required by the auditor role; every bash call keeps the session cwd."
            },
            "escalation_channel": {
              "const": "forbidden"
            },
            "forbidden_arguments": {
              "const": ["sandbox_permissions", "justification"]
            },
            "forbidden_argument_values": {
              "const": "all-including-workspace-write-and-danger-full-access"
            },
            "denial_policy": {
              "const": "RETAINED-no-retry-on-denial-or-schema-error"
            }
          }
        },
        "repair_candidate": {
          "type": "object",
          "properties": {
            "candidate_location": {
              "const": "shadow-repo-under-workspace"
            },
            "directory_template": {
              "type": "string",
              "pattern": "^[^/]+-repair-<digest16>$"
            },
            "branch_template": {
              "const": "dsh/repair-<digest16>"
            },
            "candidate_root": {
              "const": "${session-cwd}/<workspace>/candidates/repair-<digest16>"
            },
            "forbidden_candidate_location": {
              "const": "under-product-root-or-git"
            },
            "candidate_workdir": {
              "type": "string",
              "pattern": "^[^/]+-repair-<digest16>$"
            },
            "provision_workdir": {
              "const": "omitted-session-cwd"
            },
            "provision_command": {
              "type": "string",
              "minLength": 1
            },
            "candidate_diff_command": {
              "type": "string",
              "minLength": 1
            },
            "recording_command": {
              "type": "string",
              "minLength": 1
            },
            "record_before_first_edit": {
              "const": true
            },
            "record_statuses": {
              "const": [
                "PROVISIONED",
                "DIRTY"
              ]
            },
            "reconcile_command": {
              "type": "string",
              "minLength": 1
            },
            "resume_command": {
              "type": "string",
              "minLength": 1
            },
            "resume_policy": {
              "const": "exact-recorded-only"
            },
            "resume_statuses": {
              "const": [
                "DIRTY",
                "RETAINED-pending-verification"
              ]
            },
            "stale_record_policy": {
              "const": "reconcile-then-resume"
            },
            "stale_record_precondition": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "resume_required_checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "unrecorded_dirty_target": {
              "const": "RETAINED-never-adopted"
            },
            "interrupted_turn_recovery": {
              "const": "recorded-PROVISIONED-target-may-become-DIRTY-by-recording-command"
            },
            "provision_checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "unrelated_candidates": {
              "const": "ignore-preserve"
            },
            "worktree_list_scope": {
              "const": "target-path-and-target-branch-only"
            },
            "provision": {
              "const": "git-worktree-add-or-exact-safe-reuse"
            },
            "collision_policy": {
              "const": "retain-target-collision-no-improvisation"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "reuse_source": {
      "type": "string",
      "enum": [
        "base-library",
        "specialized-catalog",
        "composition",
        "override",
        "extension"
      ],
      "description": "Which layer of the skill selection strategy this mode uses."
    },
    "reuse_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Exact name of the library entry reused (base skill or catalog pattern). Required when reuse_source is 'base-library' or 'specialized-catalog'; omitted when 'extension'."
    },
    "reuse_justification": {
      "type": "string",
      "description": "Required when reuse_source is 'extension': why earlier layers do not apply."
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "anti_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Named inputs this mode consumes."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Value sources for operational data."
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths or resources this mode reads."
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths or resources this mode writes. Auditor must have empty writes for product."
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Invariants that must hold for this mode."
    },
    "anti_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things this mode must never do."
    },
    "state_machine": {
      "type": "object",
      "required": [
        "states",
        "transitions",
        "initial",
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              }
            }
          }
        },
        "initial": {
          "type": "string"
        },
        "terminal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          }
        }
      }
    },
    "failure_modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "retain",
            "rollback",
            "block"
          ]
        }
      }
    },
    "rollback": {
      "type": "string",
      "description": "Rollback strategy description."
    },
    "migration": {
      "type": "string",
      "description": "Migration strategy from previous version."
    },
    "sr_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SR-[0-9]+$"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Scenario requirements (SR-N) linked to this mode."
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to scenario IDs that test this mode."
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conditions under which this mode stops execution."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of evidence this mode produces."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Relative path to SKILL.md"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "progressive_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      }
    }
  }
}
