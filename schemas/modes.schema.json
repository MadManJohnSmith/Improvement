{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-flow:modes:1",
  "title": "Mode contract",
  "description": "Contract for a generated mode (e.g., <Project>-auditor). Located in generated/modes/<name>/. Exactly two final modes per project.",
  "x-owner": "creator",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "purpose",
    "reuse_source",
    "triggers",
    "anti_triggers",
    "inputs",
    "reads",
    "writes",
    "required_capabilities",
    "forbidden_capabilities",
    "invariants",
    "anti_goals",
    "state_machine",
    "handoffs",
    "failure_modes",
    "scenarios",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "mode",
      "description": "Explicit discriminator for mode contracts."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Mode name, project-prefixed (e.g., MyProject-auditor)."
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "reuse_source": {
      "type": "string",
      "enum": [
        "base-library",
        "specialized-catalog",
        "composition",
        "override",
        "extension"
      ],
      "description": "Which layer of the skill selection strategy this mode uses."
    },
    "reuse_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Exact name of the library entry reused (base skill or catalog pattern). Required when reuse_source is 'base-library' or 'specialized-catalog'; omitted when 'extension'."
    },
    "reuse_justification": {
      "type": "string",
      "description": "Required when reuse_source is 'extension': why earlier layers do not apply."
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "anti_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Named inputs this mode consumes."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Value sources for operational data."
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths or resources this mode reads."
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths or resources this mode writes. Auditor must have empty writes for product."
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Invariants that must hold for this mode."
    },
    "anti_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things this mode must never do."
    },
    "state_machine": {
      "type": "object",
      "required": [
        "states",
        "transitions",
        "initial",
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              }
            }
          }
        },
        "initial": {
          "type": "string"
        },
        "terminal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          }
        }
      }
    },
    "failure_modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "retain",
            "rollback",
            "block"
          ]
        }
      }
    },
    "rollback": {
      "type": "string",
      "description": "Rollback strategy description."
    },
    "migration": {
      "type": "string",
      "description": "Migration strategy from previous version."
    },
    "sr_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SR-[0-9]+$"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Scenario requirements (SR-N) linked to this mode."
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to scenario IDs that test this mode."
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conditions under which this mode stops execution."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of evidence this mode produces."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Relative path to SKILL.md"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "progressive_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      }
    }
  }
}
