{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-flow:design:1",
  "title": "Design artifacts schema",
  "description": "Schemas for design artifacts under design/ (§24, §32). Encodes decision ledger (INFER, ASK, RECOMMEND, NOT_APPLICABLE, UNRESOLVED) and capability plan.",
  "x-owner": "creator",
  "type": "object",
  "required": ["schema_version", "project", "strategy", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "strategy": {
      "type": "object",
      "required": ["selection_order", "modes"],
      "additionalProperties": false,
      "properties": {
        "selection_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "modes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_entry" }
    },
    "capability_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "partitions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "decision_entry": {
      "type": "object",
      "required": ["id", "subject", "resolution", "justification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "resolution": {
          "type": "string",
          "enum": ["INFER", "ASK", "RECOMMEND", "NOT_APPLICABLE", "UNRESOLVED"]
        },
        "justification": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    }
  }
}
