{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-flow:executable-corpus:1",
  "title": "Host-compiled executable skill corpus",
  "x-owner": "host",
  "type": "object",
  "required": ["schema_version", "compiler_version", "source_digest", "corpus_digest", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/digest"},
    "corpus_digest": {"$ref": "#/$defs/digest"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {
      "type": "object",
      "required": ["schema_version", "case_id", "type", "target_skill", "input"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "type": {"enum": ["positive", "negative", "boundary", "capability-denial", "prompt-injection", "idempotence", "scope-violation", "write-violation"]},
        "target_skill": {"type": "string", "minLength": 1, "maxLength": 128},
        "input": {
          "type": "object",
          "required": ["task", "target"],
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          },
          "properties": {
            "task": {"type": "string", "minLength": 1, "maxLength": 1024},
            "target": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    }
  }
}
